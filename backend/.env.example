# ראו גם /.env.example בשורש הפרויקט. קובץ זה ספציפי להרצת ה-Backend מקומית.
DATABASE_URL=postgresql://carlot:carlot@localhost:5432/carlot_dev
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
# כתובת ה-Frontend הציבורית, בייצור בלבד — מגבילה CORS לכתובת הזו בלבד
# (כמה כתובות מופרדות בפסיק אם צריך). בפיתוח מקומי אפשר להשאיר ריק.
FRONTEND_URL=
# סיסמת המשתמש owner@demo.local שנוצר ע"י prisma db seed — לייצור יש להגדיר
# סיסמה חזקה ולשנות אותה מיד לאחר ההתחברות הראשונה. לעולם לא לשמור כאן בפועל.
SEED_OWNER_PASSWORD=
