// Schema for MVP modules 1-3: organizations, branches, users, roles, audit
// log, vehicle inventory, and CRM (customers/leads). See
// ../../docs/data-model.md for the full target model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  OWNER
  SALES_MANAGER
  SALESPERSON
  INVENTORY_MANAGER
  OPERATIONS
  FINANCE
  VIEWER
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branches Branch[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  address        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]
  vehicles     Vehicle[]

  @@map("branches")
}

model User {
  id           String    @id @default(uuid())
  branchId     String?   @map("branch_id")
  fullName     String    @map("full_name")
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  branch Branch?    @relation(fields: [branchId], references: [id])
  roles  UserRole[]

  @@map("users")
}

model UserRole {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  role     RoleName
  // הרשאה זו יכולה להיות מוגבלת לסניף מסוים בלבד (branch_scope null = כל הסניפים)
  branchScopeId String? @map("branch_scope_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, role, branchScopeId])
  @@map("user_roles")
}

enum VehicleStatus {
  CANDIDATE
  INTAKE
  RECONDITIONING
  AVAILABLE
  RESERVED
  IN_DEAL
  SOLD
  DELIVERED
  CANCELLED
  RETURNED_TO_SUPPLIER
}

enum ExpenseCategory {
  PURCHASE
  RECONDITIONING
  TRANSPORT
  MARKETING
  OTHER
}

model Vehicle {
  id             String        @id @default(uuid())
  branchId       String        @map("branch_id")
  licensePlate   String?       @map("license_plate")
  vin            String?
  manufacturer   String
  model          String
  year           Int
  mileageKm      Int?          @map("mileage_km")
  color          String?
  status         VehicleStatus @default(CANDIDATE)
  purchasePrice  Decimal?      @map("purchase_price") @db.Decimal(12, 2)
  listPrice      Decimal?      @map("list_price") @db.Decimal(12, 2)
  location       String?
  responsibleUserId String?    @map("responsible_user_id")
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  branch   Branch          @relation(fields: [branchId], references: [id])
  events   VehicleEvent[]
  expenses Expense[]

  // A given license plate or VIN should not appear twice among vehicles that
  // are not soft-deleted — partial-style uniqueness is enforced in the
  // service layer (Prisma doesn't support partial unique indexes portably),
  // see VehiclesService.assertNoDuplicate().
  @@map("vehicles")
}

/// Append-only history — never updated or deleted, see docs/architecture.md.
model VehicleEvent {
  id           String   @id @default(uuid())
  vehicleId    String   @map("vehicle_id")
  eventType    String   @map("event_type")
  fieldChanged String?  @map("field_changed")
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  actorId      String?  @map("actor_id")
  createdAt    DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("vehicle_events")
}

model Expense {
  id          String          @id @default(uuid())
  vehicleId   String          @map("vehicle_id")
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  createdBy   String?         @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("expenses")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING
  TEST_DRIVE
  OFFER
  NEGOTIATION
  WON
  LOST
  NOT_RELEVANT
  FUTURE_NURTURE
}

model Customer {
  id                String    @id @default(uuid())
  fullName          String    @map("full_name")
  phone             String
  email             String?
  city              String?
  marketingConsent  Boolean   @default(false) @map("marketing_consent")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  leads Lead[]

  @@map("customers")
}

model Lead {
  id             String     @id @default(uuid())
  customerId     String     @map("customer_id")
  source         String
  status         LeadStatus @default(NEW)
  ownerUserId    String     @map("owner_user_id")
  preferences    Json?
  nextActionDate DateTime?  @map("next_action_date")
  lossReason     String?    @map("loss_reason")
  version        Int        @default(1)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([ownerUserId])
  @@map("leads")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  actorId    String?  @map("actor_id")
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_logs")
}
