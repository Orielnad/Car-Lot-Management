// Schema for MVP modules 1-8: organizations, branches, users, roles, audit
// log, vehicle inventory, CRM (customers/leads), tasks, the lead-vehicle
// matching engine, price quotes, deals/payments, and documents. See
// ../../docs/data-model.md for the full target model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  OWNER
  SALES_MANAGER
  SALESPERSON
  INVENTORY_MANAGER
  OPERATIONS
  FINANCE
  VIEWER
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branches Branch[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  address        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]
  vehicles     Vehicle[]

  @@map("branches")
}

model User {
  id           String    @id @default(uuid())
  branchId     String?   @map("branch_id")
  fullName     String    @map("full_name")
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  branch Branch?    @relation(fields: [branchId], references: [id])
  roles  UserRole[]

  @@map("users")
}

model UserRole {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  role     RoleName
  // הרשאה זו יכולה להיות מוגבלת לסניף מסוים בלבד (branch_scope null = כל הסניפים)
  branchScopeId String? @map("branch_scope_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, role, branchScopeId])
  @@map("user_roles")
}

enum VehicleStatus {
  CANDIDATE
  INTAKE
  RECONDITIONING
  AVAILABLE
  RESERVED
  IN_DEAL
  SOLD
  DELIVERED
  CANCELLED
  RETURNED_TO_SUPPLIER
}

enum ExpenseCategory {
  PURCHASE
  RECONDITIONING
  TRANSPORT
  MARKETING
  OTHER
}

model Vehicle {
  id             String        @id @default(uuid())
  branchId       String        @map("branch_id")
  licensePlate   String?       @map("license_plate")
  vin            String?
  manufacturer   String
  model          String
  year           Int
  mileageKm      Int?          @map("mileage_km")
  color          String?
  bodyType       String?       @map("body_type")
  gearbox        String?
  fuelType       String?       @map("fuel_type")
  status         VehicleStatus @default(CANDIDATE)
  purchasePrice  Decimal?      @map("purchase_price") @db.Decimal(12, 2)
  listPrice      Decimal?      @map("list_price") @db.Decimal(12, 2)
  location       String?
  responsibleUserId String?    @map("responsible_user_id")
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  branch   Branch          @relation(fields: [branchId], references: [id])
  events   VehicleEvent[]
  expenses Expense[]
  matches  Match[]
  quotes   Quote[]
  deals    Deal[]

  // A given license plate or VIN should not appear twice among vehicles that
  // are not soft-deleted — partial-style uniqueness is enforced in the
  // service layer (Prisma doesn't support partial unique indexes portably),
  // see VehiclesService.assertNoDuplicate().
  @@map("vehicles")
}

/// Append-only history — never updated or deleted, see docs/architecture.md.
model VehicleEvent {
  id           String   @id @default(uuid())
  vehicleId    String   @map("vehicle_id")
  eventType    String   @map("event_type")
  fieldChanged String?  @map("field_changed")
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  actorId      String?  @map("actor_id")
  createdAt    DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("vehicle_events")
}

model Expense {
  id          String          @id @default(uuid())
  vehicleId   String          @map("vehicle_id")
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  createdBy   String?         @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("expenses")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING
  TEST_DRIVE
  OFFER
  NEGOTIATION
  WON
  LOST
  NOT_RELEVANT
  FUTURE_NURTURE
}

model Customer {
  id                String    @id @default(uuid())
  fullName          String    @map("full_name")
  phone             String
  email             String?
  city              String?
  marketingConsent  Boolean   @default(false) @map("marketing_consent")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  leads Lead[]
  deals Deal[]

  @@map("customers")
}

model Lead {
  id             String     @id @default(uuid())
  customerId     String     @map("customer_id")
  source         String
  status         LeadStatus @default(NEW)
  ownerUserId    String     @map("owner_user_id")
  preferences    Json?
  nextActionDate DateTime?  @map("next_action_date")
  lossReason     String?    @map("loss_reason")
  version        Int        @default(1)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id])
  matches  Match[]
  quotes   Quote[]

  @@index([ownerUserId])
  @@map("leads")
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  REJECTED
  EXPIRED
}

/// A revised quote is a NEW row, never an overwrite of an old one (spec 7.1:
/// "גרסאות הצעה ללא דריסת גרסה קודמת") — see QuotesService.revise().
model Quote {
  id             String      @id @default(uuid())
  leadId         String      @map("lead_id")
  vehicleId      String      @map("vehicle_id")
  price          Decimal     @db.Decimal(12, 2)
  discount       Decimal     @default(0) @db.Decimal(12, 2)
  validUntil     DateTime    @map("valid_until")
  status         QuoteStatus @default(DRAFT)
  supersedesId   String?     @map("supersedes_id")
  version        Int         @default(1)
  createdBy      String      @map("created_by")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  lead      Lead     @relation(fields: [leadId], references: [id])
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  supersedes Quote?  @relation("QuoteRevision", fields: [supersedesId], references: [id])
  revisions  Quote[] @relation("QuoteRevision")
  deal       Deal?

  @@index([leadId])
  @@map("quotes")
}

/// Computed, not user-entered — see docs/data-model.md and
/// src/matching/match-score.ts. Re-computed on demand, so it's safe to
/// upsert on (leadId, vehicleId) rather than keeping a full history.
model Match {
  id          String   @id @default(uuid())
  leadId      String   @map("lead_id")
  vehicleId   String   @map("vehicle_id")
  score       Int
  explanation Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lead    Lead    @relation(fields: [leadId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([leadId, vehicleId])
  @@index([vehicleId])
  @@map("matches")
}

enum TaskType {
  CALL
  MESSAGE
  MEETING
  TEST_DRIVE
  SERVICE
  DOCUMENT
  COLLECTION
  DELIVERY
  FOLLOW_UP
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// Linked to a Lead/Customer/Vehicle/Deal by (entityType, entityId) — a
/// lightweight polymorphic reference (see docs/data-model.md), not a DB
/// foreign key, since a Task can point at several different tables.
model Task {
  id          String       @id @default(uuid())
  entityType  String       @map("entity_type")
  entityId    String       @map("entity_id")
  ownerUserId String       @map("owner_user_id")
  type        TaskType
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(OPEN)
  dueAt       DateTime?    @map("due_at")
  notes       String?
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  @@index([ownerUserId])
  @@index([entityType, entityId])
  @@map("tasks")
}

enum DealStatus {
  DRAFT
  PENDING_APPROVAL
  SIGNED
  PAID
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  TRANSFER
  CREDIT_CARD
  CHECK
  CASH
  FINANCING
  TRADE_IN
}

/// Critical business rule (spec section 20): a vehicle cannot be sold in two
/// active deals at once. Enforced with a partial unique index at the
/// database level (see migration SQL — Prisma's schema DSL can't express a
/// filtered unique constraint), not only in application code, so a race
/// between two concurrent requests still can't double-sell a vehicle.
model Deal {
  id             String     @id @default(uuid())
  quoteId        String     @unique @map("quote_id")
  customerId     String     @map("customer_id")
  vehicleId      String     @map("vehicle_id")
  salespersonId  String     @map("salesperson_id")
  salePrice      Decimal    @db.Decimal(12, 2) @map("sale_price")
  status         DealStatus @default(DRAFT)
  version        Int        @default(1)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  quote    Quote     @relation(fields: [quoteId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  payments Payment[]

  @@index([salespersonId])
  @@index([vehicleId])
  @@map("deals")
}

model Payment {
  id        String        @id @default(uuid())
  dealId    String        @map("deal_id")
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  reference String?
  createdBy String?       @map("created_by")
  createdAt DateTime      @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id])

  @@index([dealId])
  @@map("payments")
}

enum DocumentType {
  LICENSE
  INSPECTION
  SERVICE_RECORD
  INVOICE
  RECEIPT
  CONTRACT
  DISCLOSURE
  TITLE_TRANSFER
  WARRANTY
  ID_PHOTO
  OTHER
}

/// Linked to a Lead/Customer/Vehicle/Deal by (entityType, entityId) — same
/// lightweight polymorphic pattern as Task (see docs/data-model.md). A
/// revision is a new row with supersedesId, exactly like Quote: the old
/// version is never edited or deleted (spec 8: "שמירת כל גרסה, ללא דריסה").
model Document {
  id               String       @id @default(uuid())
  entityType       String       @map("entity_type")
  entityId         String       @map("entity_id")
  docType          DocumentType @map("doc_type")
  originalFileName String       @map("original_file_name")
  storedFileName   String       @unique @map("stored_file_name")
  mimeType         String       @map("mime_type")
  sizeBytes        Int          @map("size_bytes")
  version          Int          @default(1)
  supersedesId     String?      @map("supersedes_id")
  uploadedBy       String       @map("uploaded_by")
  createdAt        DateTime     @default(now()) @map("created_at")

  supersedes Document?  @relation("DocumentRevision", fields: [supersedesId], references: [id])
  revisions  Document[] @relation("DocumentRevision")

  @@index([entityType, entityId])
  @@map("documents")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  actorId    String?  @map("actor_id")
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_logs")
}
