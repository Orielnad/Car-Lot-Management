# תבנית משתני סביבה — קובץ זה לא מכיל ואסור שיכיל ערכים אמיתיים.
# יש להעתיק אותו ל-.env מקומי (לא מועלה ל-Git) ולמלא ערכים אמיתיים לפיתוח מקומי,
# ובסביבת הייצור להשתמש במנגנון ה-Secrets של ספק האירוח.

# --- כללי ---
NODE_ENV=
PORT=
APP_BASE_URL=

# --- מסד נתונים ---
DATABASE_URL=

# --- אימות והרשאות ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# --- דוא"ל / התראות (אם רלוונטי) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- אחסון קבצים (אם רלוונטי) ---
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# הערה: זו רשימת שמות המשתנים ברמת המערכת כולה. ל-Backend יש עותק ממוקד יותר
# ב-backend/.env.example, שם הוא בפועל בשימוש כרגע.
